{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan+UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "LATTICE_ASAN": "ON",
        "LATTICE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "LATTICE_TSAN": "ON"
      }
    },
    {
      "name": "local-clang-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
        "CMAKE_MAKE_PROGRAM": "$env{LOCALAPPDATA}/Microsoft/WinGet/Packages/Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe/ninja.exe"
      }
    },
    {
      "name": "local-clang-debug",
      "displayName": "Local Clang Debug",
      "inherits": ["debug", "local-clang-base"],
      "binaryDir": "${sourceDir}/build/local-clang-debug"
    },
    {
      "name": "local-clang-release",
      "displayName": "Local Clang Release",
      "inherits": ["release", "local-clang-base"],
      "binaryDir": "${sourceDir}/build/local-clang-release"
    },
    {
      "name": "local-clang-asan-release",
      "displayName": "Local Clang ASan+UBSan Release",
      "inherits": ["release", "local-clang-base"],
      "binaryDir": "${sourceDir}/build/local-clang-asan-release",
      "cacheVariables": {
        "LATTICE_ASAN": "ON",
        "LATTICE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "local-clang-debug", "configurePreset": "local-clang-debug" },
    { "name": "local-clang-release", "configurePreset": "local-clang-release" },
    { "name": "local-clang-asan-release", "configurePreset": "local-clang-asan-release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "local-clang-debug",
      "configurePreset": "local-clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "local-clang-release",
      "configurePreset": "local-clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "local-clang-asan-release",
      "configurePreset": "local-clang-asan-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
